<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Atouop_control</title>
<meta name="description" content="Atouop 个人主页的控制台：管理全部 9 个工具的数据，所有修改即时同步到主页。">
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2064%2064'%3E%3Crect%20width='64'%20height='64'%20fill='%2305070c'/%3E%3Ctext%20x='32'%20y='44'%20font-family='monospace'%20font-size='36'%20font-weight='700'%20fill='%233d7bff'%20text-anchor='middle'%3EA%3C/text%3E%3C/svg%3E">
<style>
  :root {
    --bg: #05070c;
    --bg-soft: #0a1122;
    --card: rgba(255, 255, 255, 0.03);
    --header-bg: rgba(5, 7, 12, 0.82);
    --line: rgba(120, 160, 255, 0.16);
    --line-strong: rgba(120, 160, 255, 0.35);
    --text: #eef3fb;
    --muted: #8b96ab;
    --accent: #3d7bff;
    --accent-soft: rgba(61, 123, 255, 0.14);
    --danger: #ef476f;
    --ok: #06d6a0;
    --star-rgb: 150, 195, 255;
    --mono: 'JetBrains Mono', Consolas, monospace;
    --sans: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }
  html.light {
    --bg: #f3f6fc;
    --bg-soft: #ffffff;
    --card: rgba(20, 45, 90, 0.035);
    --header-bg: rgba(243, 246, 252, 0.86);
    --line: rgba(20, 45, 90, 0.14);
    --line-strong: rgba(20, 45, 90, 0.28);
    --text: #0b1526;
    --muted: #5a6a85;
    --accent: #2f6bff;
    --accent-soft: rgba(47, 107, 255, 0.1);
    --danger: #e0325c;
    --ok: #05a87f;
    --star-rgb: 70, 110, 190;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    min-height: 100vh;
    line-height: 1.6;
  }
  canvas#stars {
    position: fixed; inset: 0;
    width: 100%; height: 100%;
    z-index: 0; pointer-events: none;
  }
  .wrap { position: relative; z-index: 1; max-width: 980px; margin: 0 auto; padding: 0 20px 60px; }

  /* 顶栏 */
  header.top {
    position: sticky; top: 0; z-index: 10;
    display: flex; align-items: center; gap: 14px;
    padding: 14px 20px;
    background: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  header.top .logo {
    font-family: var(--mono); font-weight: 700; font-size: 1rem;
    color: var(--text); letter-spacing: 0.06em;
    display: flex; align-items: center; gap: 8px;
  }
  header.top .logo b { color: var(--accent); }
  header.top .sp { flex: 1; }
  .link {
    color: var(--muted); text-decoration: none; font-size: 0.85rem;
    padding: 6px 12px; border: 1px solid var(--line); border-radius: 8px;
    transition: all 0.2s;
  }
  .link:hover { color: var(--text); border-color: var(--line-strong); background: var(--accent-soft); }

  /* 标题区 */
  .hero { padding: 34px 4px 8px; }
  .hero h1 { font-size: 1.7rem; font-weight: 700; letter-spacing: 0.02em; }
  .hero h1 em { font-style: normal; color: var(--accent); }
  .hero p { color: var(--muted); font-size: 0.9rem; margin-top: 6px; }

  /* 概览统计 */
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(132px, 1fr)); gap: 12px; margin: 22px 0 30px; }
  .stat {
    border: 1px solid var(--line); border-radius: 12px;
    background: var(--card); padding: 14px 16px;
  }
  .stat b { display: block; font-family: var(--mono); font-size: 1.35rem; color: var(--accent); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .stat span { font-size: 0.76rem; color: var(--muted); }

  /* 模块卡片 */
  .mod {
    border: 1px solid var(--line); border-radius: 14px;
    background: var(--card); padding: 20px 20px 22px;
    margin-bottom: 20px;
  }
  .mod h2 {
    font-size: 1.02rem; font-weight: 600;
    display: flex; align-items: center; gap: 10px;
    padding-bottom: 12px; border-bottom: 1px solid var(--line);
    margin-bottom: 14px;
  }
  .mod h2 .no {
    font-family: var(--mono); font-size: 0.72rem; color: var(--accent);
    border: 1px solid var(--line-strong); border-radius: 6px;
    padding: 2px 8px;
  }
  .mod h2 .sp { flex: 1; }
  .empty-tip { color: var(--muted); font-size: 0.85rem; padding: 8px 2px; }
  .badge { font-size: 0.74rem; padding: 2px 9px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--muted); }
  .badge.on { color: var(--ok); border-color: rgba(6, 214, 160, 0.5); }

  .row { display: flex; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
  .row:last-child { margin-bottom: 0; }
  .input {
    flex: 1; min-width: 140px;
    background: var(--bg-soft); color: var(--text);
    border: 1px solid var(--line); border-radius: 9px;
    padding: 9px 12px; font-size: 0.88rem; font-family: var(--sans);
    outline: none; transition: border-color 0.2s;
  }
  .input:focus { border-color: var(--accent); }
  select.input { cursor: pointer; }
  textarea.input { min-height: 76px; resize: vertical; font-family: var(--mono); font-size: 0.82rem; }

  .btn {
    border: 1px solid var(--line-strong); background: transparent; color: var(--text);
    border-radius: 9px; padding: 9px 16px; font-size: 0.85rem; cursor: pointer;
    transition: all 0.2s; font-family: var(--sans);
  }
  .btn:hover { background: var(--accent-soft); border-color: var(--accent); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn.primary:hover { filter: brightness(1.12); }
  .btn.danger { border-color: rgba(239, 71, 111, 0.5); color: var(--danger); }
  .btn.danger:hover { background: rgba(239, 71, 111, 0.14); border-color: var(--danger); }
  .btn.sm { padding: 5px 11px; font-size: 0.78rem; }

  /* 列表 */
  ul.list { list-style: none; }
  ul.list li {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 4px; border-bottom: 1px dashed rgba(120, 160, 255, 0.1);
    font-size: 0.9rem;
  }
  ul.list li:last-child { border-bottom: none; }
  ul.list li.done .t { text-decoration: line-through; color: var(--muted); }
  ul.list li .t { flex: 1; word-break: break-all; }
  ul.list li time { font-family: var(--mono); font-size: 0.7rem; color: var(--muted); white-space: nowrap; }
  .chk { width: 17px; height: 17px; accent-color: var(--accent); cursor: pointer; }

  /* 表格 */
  table.tbl { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  table.tbl th, table.tbl td { text-align: left; padding: 8px 6px; border-bottom: 1px solid rgba(120, 160, 255, 0.1); }
  table.tbl th { color: var(--muted); font-weight: 500; font-size: 0.78rem; letter-spacing: 0.05em; }
  table.tbl td.num { font-family: var(--mono); }

  /* 像素画预览 */
  .px-wrap { display: flex; gap: 18px; align-items: flex-start; flex-wrap: wrap; }
  .px-canvas {
    width: 256px; height: 256px;
    image-rendering: pixelated;
    border: 1px solid var(--line-strong); border-radius: 8px;
    background: #070a14;
  }
  .px-meta { font-size: 0.82rem; color: var(--muted); line-height: 2; }

  /* 倒计时大数字 */
  .cd-big {
    font-family: var(--mono); font-size: 1.9rem; font-weight: 700; color: var(--text);
    letter-spacing: 0.03em; margin: 4px 0 2px;
  }
  .cd-big em { font-style: normal; color: var(--accent); }
  .cd-name { color: var(--muted); font-size: 0.88rem; margin-bottom: 12px; }

  /* 每日一句 */
  .q-card {
    border: 1px solid var(--line); border-radius: 12px; background: var(--card);
    padding: 16px 18px; margin-bottom: 12px;
  }
  .q-card .qt { font-size: 1.02rem; line-height: 1.75; }
  .q-card .qa { font-family: var(--mono); font-size: 0.78rem; color: var(--muted); margin-top: 8px; }
  .q-label { font-size: 0.76rem; color: var(--muted); letter-spacing: 0.05em; margin-bottom: 6px; }

  /* 网盘历史 */
  .pan-link { font-family: var(--mono); font-size: 0.76rem; color: var(--muted); word-break: break-all; }
  .pan-plat { font-size: 0.8rem; color: var(--text); white-space: nowrap; }

  footer { color: var(--muted); font-size: 0.75rem; text-align: center; padding: 30px 0 10px; font-family: var(--mono); letter-spacing: 0.08em; }
  footer a { color: var(--muted); }
  footer a:hover { color: var(--accent); }
</style>
</head>
<body>
<canvas id="stars" aria-hidden="true"></canvas>

<header class="top">
  <div class="logo">ATOUOP_CONTROL</div>
  <span class="sp"></span>
  <a class="link" href="index.html" id="link-home">← 回到主页</a>
  <a class="link" href="#" id="link-theme" title="切换深浅色主题（同步主页）">主题</a>
</header>

<div class="wrap">
  <div class="hero">
    <h1>Atouop <em>控制台</em></h1>
    <p>集中管理主页全部 9 个工具的数据：弹幕、待办、倒计时、绩点、像素画、随机决定器、世界时钟、每日一句、网盘助手；并提供访客人数与 IP 统计。所有修改即时同步到主页。</p>
  </div>

  <!-- 概览 -->
  <div class="stats" id="stats">
    <div class="stat"><b id="st-todo">0</b><span>待办（完成率 0%）</span></div>
    <div class="stat"><b id="st-dama">0</b><span>弹幕条数</span></div>
    <div class="stat"><b id="st-cd">—</b><span>倒计时目标</span></div>
    <div class="stat"><b id="st-gpa">—</b><span>GPA / 加权分</span></div>
    <div class="stat"><b id="st-px">0</b><span>像素画格子</span></div>
    <div class="stat"><b id="st-tz">—</b><span>世界时钟时区</span></div>
    <div class="stat"><b id="st-q">今日</b><span>每日一句置顶</span></div>
    <div class="stat"><b id="st-pan">0</b><span>网盘解析记录</span></div>
    <div class="stat"><b id="st-hits">—</b><span>总访问次数</span></div>
    <div class="stat"><b id="st-uniq">—</b><span>独立访客数</span></div>
  </div>

  <!-- 弹幕 -->
  <div class="mod" id="m-dama">
    <h2><span class="no">01</span>弹幕墙<span class="sp"></span><button class="btn danger sm" id="dama-clear" type="button">清空全部</button></h2>
    <div class="row">
      <input class="input" id="dama-input" type="text" placeholder="新弹幕内容（同步到主页弹幕墙）" maxlength="40">
      <button class="btn primary" id="dama-add" type="button">添加</button>
    </div>
    <ul class="list" id="dama-list"></ul>
  </div>

  <!-- 待办 -->
  <div class="mod" id="m-todo">
    <h2><span class="no">02</span>待办清单<span class="sp"></span><button class="btn danger sm" id="todo-clear" type="button">清空已勾选</button></h2>
    <div class="row">
      <input class="input" id="todo-input" type="text" placeholder="新待办（同步到主页待办清单）" maxlength="60">
      <button class="btn primary" id="todo-add" type="button">添加</button>
    </div>
    <ul class="list" id="todo-list"></ul>
  </div>

  <!-- 倒计时 -->
  <div class="mod" id="m-cd">
    <h2><span class="no">03</span>倒计时目标</h2>
    <div id="cd-empty" class="empty-tip">主页还没有设置倒计时目标。</div>
    <div id="cd-body" hidden>
      <div class="cd-big" id="cd-clock">-- 天 --:--:--</div>
      <div class="cd-label" id="cd-label"></div>
      <div class="row">
        <input class="input" id="cd-name" type="text" placeholder="目标名称" maxlength="20">
        <input class="input" id="cd-date" type="datetime-local">
        <button class="btn primary" id="cd-save" type="button">保存修改</button>
        <button class="btn danger" id="cd-del" type="button">删除目标</button>
      </div>
    </div>
  </div>

  <!-- 绩点 -->
  <div class="mod" id="m-gpa">
    <h2><span class="no">04</span>绩点计算器数据<span class="sp"></span><button class="btn danger sm" id="gpa-clear" type="button">清空全部</button></h2>
    <div class="row">
      <input class="input" id="gpa-in-name" type="text" placeholder="课程名称" maxlength="24">
      <input class="input" id="gpa-in-credit" type="number" min="0" step="0.5" placeholder="学分" style="max-width:110px">
      <input class="input" id="gpa-in-score" type="number" min="0" max="100" step="0.5" placeholder="分数(0-100)" style="max-width:130px">
      <button class="btn primary" id="gpa-add" type="button">添加课程</button>
    </div>
    <div id="gpa-empty" class="empty-tip">主页还没有录入课程。</div>
    <div id="gpa-body" hidden>
      <table class="tbl" id="gpa-tbl">
        <thead><tr><th>课程</th><th>学分</th><th>分数</th><th></th></tr></thead>
        <tbody id="gpa-tbody"></tbody>
      </table>
    </div>
  </div>

  <!-- 像素画 -->
  <div class="mod" id="m-px">
    <h2><span class="no">05</span>像素涂鸦作品<span class="sp"></span><button class="btn danger sm" id="px-clear" type="button">清空画布</button></h2>
    <div class="px-wrap">
      <canvas class="px-canvas" id="px-canvas" width="256" height="256"></canvas>
      <div class="px-meta" id="px-meta">还没有像素画作品。</div>
    </div>
  </div>

  <!-- 随机选项 -->
  <div class="mod" id="m-rand">
    <h2><span class="no">06</span>随机决定器选项</h2>
    <div class="row">
      <textarea class="input" id="rand-options" placeholder="每行一个选项，与主页随机决定器同步"></textarea>
    </div>
    <div class="row">
      <button class="btn primary" id="rand-save" type="button">保存选项</button>
    </div>
  </div>

  <!-- 世界时钟 -->
  <div class="mod" id="m-clock">
    <h2><span class="no">07</span>世界时钟默认时区<span class="sp"></span><span class="badge" id="clock-badge">默认</span></h2>
    <div class="row">
      <select class="input" id="clock-tz"></select>
      <button class="btn primary" id="clock-save" type="button">保存为默认</button>
      <button class="btn" id="clock-reset" type="button">恢复北京</button>
    </div>
    <p class="empty-tip">主页打开世界时钟时会自动使用这里设置的时区；在主页切换时区也会自动回存。</p>
  </div>

  <!-- 每日一句 -->
  <div class="mod" id="m-q">
    <h2><span class="no">08</span>每日一句<span class="sp"></span><span class="badge" id="q-badge">未置顶</span></h2>
    <div class="q-label">今天的句子</div>
    <div class="q-card" id="q-today"></div>
    <div class="row">
      <select class="input" id="q-pick"></select>
      <button class="btn primary" id="q-pin" type="button">置顶这一句</button>
      <button class="btn" id="q-unpin" type="button">取消置顶</button>
    </div>
    <p class="empty-tip">置顶后，主页每次打开每日一句都会固定显示这一句；取消置顶则恢复每天自动轮换。</p>
  </div>

  <!-- 网盘助手 -->
  <div class="mod" id="m-pan">
    <h2><span class="no">09</span>网盘助手解析记录<span class="sp"></span><button class="btn danger sm" id="pan-clear" type="button">清空记录</button></h2>
    <ul class="list" id="pan-list"></ul>
  </div>

  <!-- 访客统计 -->
  <div class="mod" id="m-vis">
    <h2><span class="no">10</span>访客与 IP<span class="sp"></span><button class="btn sm" id="vis-refresh" type="button">刷新</button></h2>
    <div id="vis-tip" class="empty-tip">部署到 Cloudflare Pages 后，这里会显示访客的真实 IP 与归属地。</div>
    <div id="vis-body" hidden>
      <table class="tbl" id="vis-tbl">
        <thead><tr><th>IP</th><th>归属地</th><th>时间</th><th>设备 / 来源</th></tr></thead>
        <tbody id="vis-tbody"></tbody>
      </table>
    </div>
  </div>

  <footer>ATOUOP_CONTROL — 数据保存在本浏览器，与 <a href="index.html">主页</a> 同步</footer>
</div>

<script>
  // ===== 工具函数 =====
  function store(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} }
  function load(k, d) { try { var v = localStorage.getItem(k); return v === null ? d : JSON.parse(v); } catch (e) { return d; } }
  function el(id) { return document.getElementById(id); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function pad2(n) { return (n < 10 ? '0' : '') + n; }
  function fmtTime(ts) {
    var d = new Date(ts);
    return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) + ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes());
  }

  // ===== 每日一句 / 时区数据（与主页一致）=====
  var QUOTES = [
    ['路漫漫其修远兮，吾将上下而求索。', '屈原 · 离骚'],
    ['长风破浪会有时，直挂云帆济沧海。', '李白 · 行路难'],
    ['会当凌绝顶，一览众山小。', '杜甫 · 望岳'],
    ['山重水复疑无路，柳暗花明又一村。', '陆游 · 游山西村'],
    ['纸上得来终觉浅，绝知此事要躬行。', '陆游 · 冬夜读书示子聿'],
    ['不积跬步，无以至千里；不积小流，无以成江海。', '荀子 · 劝学'],
    ['博观而约取，厚积而薄发。', '苏轼'],
    ['宝剑锋从磨砺出，梅花香自苦寒来。', '警世贤文'],
    ['与其临渊羡鱼，不如退而结网。', '汉书 · 董仲舒传'],
    ['学而不思则罔，思而不学则殆。', '论语 · 为政'],
    ['知之者不如好之者，好之者不如乐之者。', '论语 · 雍也'],
    ['stay hungry, stay foolish.', 'Steve Jobs'],
    ['The best way to predict the future is to invent it.', 'Alan Kay'],
    ['Do not go gentle into that good night.', 'Dylan Thomas'],
    ['凡是过往，皆为序章。', '莎士比亚（转引）'],
    ['心之所向，素履以往。', '木心（转引）'],
    ['星光不问赶路人，时光不负有心人。', '佚名'],
    ['且视他人之疑目如盏盏鬼火，大胆去走你的夜路。', '史铁生'],
    ['行动是治愈恐惧的良药，而犹豫将不断滋养恐惧。', '佚名'],
    ['种一棵树最好的时间是十年前，其次是现在。', '非洲谚语'],
    ['日日行，不怕千万里；常常做，不怕千万事。', '格言联璧'],
    ['知不足而奋进，望远山而前行。', '佚名'],
    ['慢慢来，比较快。', '佚名'],
    ['生活的理想，就是为了理想的生活。', '张闻天']
  ];
  var ZONES = [
    ['-720', 'UTC-12 埃尼威托克'], ['-660', 'UTC-11 帕果帕果'], ['-600', 'UTC-10 檀香山'],
    ['-540', 'UTC-9 安克雷奇'], ['-480', 'UTC-8 洛杉矶 / 温哥华'], ['-420', 'UTC-7 丹佛'],
    ['-360', 'UTC-6 芝加哥'], ['-300', 'UTC-5 纽约 / 多伦多'], ['-240', 'UTC-4 圣地亚哥'],
    ['-210', 'UTC-3:30 圣约翰斯'], ['-180', 'UTC-3 圣保罗'], ['-120', 'UTC-2 南乔治亚'],
    ['-60', 'UTC-1 亚速尔'], ['0', 'UTC±0 伦敦 / 里斯本'],
    ['60', 'UTC+1 巴黎 / 柏林 / 罗马'], ['120', 'UTC+2 开罗 / 雅典'],
    ['180', 'UTC+3 莫斯科 / 伊斯坦布尔'], ['210', 'UTC+3:30 德黑兰'],
    ['240', 'UTC+4 迪拜'], ['270', 'UTC+4:30 喀布尔'],
    ['300', 'UTC+5 卡拉奇'], ['330', 'UTC+5:30 孟买 / 德里'],
    ['345', 'UTC+5:45 加德满都'], ['360', 'UTC+6 达卡'], ['390', 'UTC+6:30 仰光'],
    ['420', 'UTC+7 曼谷 / 雅加达'], ['480', 'UTC+8 北京 / 新加坡 / 香港'],
    ['525', 'UTC+8:45 尤克拉'], ['540', 'UTC+9 东京 / 首尔'], ['570', 'UTC+9:30 阿德莱德'],
    ['600', 'UTC+10 悉尼 / 布里斯班'], ['660', 'UTC+11 努美阿'],
    ['720', 'UTC+12 奥克兰 / 斐济'], ['780', 'UTC+13 汤加'], ['840', 'UTC+14 圣诞岛']
  ];
  function tzLabel(off) {
    for (var i = 0; i < ZONES.length; i++) if (parseInt(ZONES[i][0], 10) === off) return ZONES[i][1];
    return 'UTC' + (off >= 0 ? '+' : '') + (off / 60);
  }

  // ===== 主题（与主页 atouop:theme 同步）=====
  var theme = load('atouop:theme', 'dark');
  function applyTheme() { document.documentElement.classList.toggle('light', theme === 'light'); }
  el('link-theme').addEventListener('click', function (e) {
    e.preventDefault();
    theme = theme === 'light' ? 'dark' : 'light';
    store('atouop:theme', theme);
    applyTheme();
  });

  // ===== 背景星星 =====
  (function () {
    var cv = el('stars');
    var ctx = cv.getContext('2d');
    var stars = [];
    function resize() {
      cv.width = window.innerWidth; cv.height = window.innerHeight;
      var n = Math.floor(cv.width * cv.height / 9000);
      stars = [];
      for (var i = 0; i < n; i++) {
        stars.push({ x: Math.random(), y: Math.random(), r: Math.random() * 1.4 + 0.3, a: Math.random() * Math.PI * 2, s: 0.005 + Math.random() * 0.01, tw: 0.3 + Math.random() * 0.7 });
      }
    }
    function frame() {
      ctx.clearRect(0, 0, cv.width, cv.height);
      var now = performance.now();
      var rgb = getComputedStyle(document.documentElement).getPropertyValue('--star-rgb').trim() || '150,195,255';
      for (var i = 0; i < stars.length; i++) {
        var st = stars[i];
        var alpha = 0.25 + 0.75 * (0.5 + 0.5 * Math.sin(now * st.s + st.a)) * st.tw;
        ctx.fillStyle = 'rgba(' + rgb + ',' + alpha.toFixed(3) + ')';
        ctx.beginPath();
        ctx.arc(st.x * cv.width, st.y * cv.height, st.r, 0, Math.PI * 2);
        ctx.fill();
      }
      requestAnimationFrame(frame);
    }
    resize();
    window.addEventListener('resize', resize);
    requestAnimationFrame(frame);
  })();

  // ===== 概览 =====
  function renderStats() {
    var todos = load('atouop:todos', []);
    var done = todos.filter(function (t) { return t.done; }).length;
    el('st-todo').textContent = todos.length + ' 项';
    el('st-todo').nextElementSibling.textContent = '待办 · 完成 ' + done + '/' + todos.length + (todos.length ? '（' + Math.round(done / todos.length * 100) + '%）' : '');
    el('st-dama').textContent = load('atouop:danmaku', []).length + ' 条';
    var cd = load('atouop:cd', null);
    el('st-cd').textContent = cd ? cd.name.slice(0, 6) : '未设置';
    var gpa = load('atouop:gpa', []);
    if (Array.isArray(gpa) && gpa.length) {
      var credits = 0, sum = 0, sumc = 0;
      for (var i = 0; i < gpa.length; i++) {
        var c = parseFloat(gpa[i].credit) || 0;
        var s = parseFloat(gpa[i].score) || 0;
        if (c > 0 && s > 0) { credits += c; sum += c * s; sumc += c; }
      }
      var wavg = sumc ? (sum / sumc).toFixed(1) : '—';
      var g = sumc ? (sum / sumc / 20 - 1).toFixed(2) : '—';
      el('st-gpa').textContent = g + ' / ' + wavg;
    } else {
      el('st-gpa').textContent = '未录入';
    }
    var grid = load('atouop:pixels', []);
    var filled = Array.isArray(grid) ? grid.filter(function (v) { return v; }).length : 0;
    el('st-px').textContent = filled + ' 格';
    var tz = load('atouop:clocktz', 480);
    el('st-tz').textContent = 'UTC' + (tz >= 0 ? '+' : '') + (tz / 60);
    var pin = load('atouop:pinquote', null);
    el('st-q').textContent = pin == null ? '今日' : '已置顶';
    var ph = load('atouop:panhist', []);
    el('st-pan').textContent = (Array.isArray(ph) ? ph.length : 0) + ' 条';
  }

  // ===== 弹幕 =====
  var damaList = load('atouop:danmaku', []);
  if (!Array.isArray(damaList)) damaList = [];
  function damaRender() {
    var box = el('dama-list');
    if (!damaList.length) { box.innerHTML = '<li class="t">还没有弹幕。</li>'; return; }
    box.innerHTML = '';
    for (var i = damaList.length - 1; i >= 0; i--) {
      var li = document.createElement('li');
      li.innerHTML = '<span class="t">' + esc(damaList[i]) + '</span><button class="btn danger sm" data-i="' + i + '" type="button">删除</button>';
      box.appendChild(li);
    }
    box.querySelectorAll('button').forEach(function (b) {
      b.addEventListener('click', function () {
        damaList.splice(parseInt(b.getAttribute('data-i'), 10), 1);
        store('atouop:danmaku', damaList);
        damaRender(); renderStats();
      });
    });
  }
  el('dama-add').addEventListener('click', function () {
    var v = el('dama-input').value.trim();
    if (!v) return;
    damaList.push(v);
    el('dama-input').value = '';
    store('atouop:danmaku', damaList);
    damaRender(); renderStats();
  });
  el('dama-input').addEventListener('keydown', function (e) { if (e.key === 'Enter') el('dama-add').click(); });
  el('dama-clear').addEventListener('click', function () {
    if (!damaList.length) return;
    if (!confirm('确定清空全部弹幕？')) return;
    damaList = [];
    store('atouop:danmaku', damaList);
    damaRender(); renderStats();
  });

  // ===== 待办 =====
  var todos = load('atouop:todos', []);
  if (!Array.isArray(todos)) todos = [];
  function todoRender() {
    var box = el('todo-list');
    if (!todos.length) { box.innerHTML = '<li class="t">还没有待办。</li>'; return; }
    box.innerHTML = '';
    todos.forEach(function (t, i) {
      var li = document.createElement('li');
      li.className = t.done ? 'done' : '';
      var cb = document.createElement('input');
      cb.type = 'checkbox'; cb.className = 'chk'; cb.checked = !!t.done;
      cb.addEventListener('change', function () {
        t.done = cb.checked;
        li.className = t.done ? 'done' : '';
        store('atouop:todos', todos);
        renderStats();
      });
      var span = document.createElement('span');
      span.className = 't';
      span.textContent = t.text;
      var btn = document.createElement('button');
      btn.className = 'btn danger sm'; btn.type = 'button'; btn.textContent = '删除';
      btn.addEventListener('click', function () {
        todos.splice(i, 1);
        store('atouop:todos', todos);
        todoRender(); renderStats();
      });
      li.appendChild(cb); li.appendChild(span); li.appendChild(btn);
      box.appendChild(li);
    });
  }
  el('todo-add').addEventListener('click', function () {
    var v = el('todo-input').value.trim();
    if (!v) return;
    todos.push({ text: v, done: false });
    el('todo-input').value = '';
    store('atouop:todos', todos);
    todoRender(); renderStats();
  });
  el('todo-input').addEventListener('keydown', function (e) { if (e.key === 'Enter') el('todo-add').click(); });
  el('todo-clear').addEventListener('click', function () {
    var n = todos.length;
    todos = todos.filter(function (t) { return !t.done; });
    if (todos.length === n) return;
    store('atouop:todos', todos);
    todoRender(); renderStats();
  });

  // ===== 倒计时 =====
  var cdTimer = null;
  function cdRender() {
    var cd = load('atouop:cd', null);
    var empty = el('cd-empty'), body = el('cd-body');
    if (!cd) {
      empty.hidden = false; body.hidden = true;
      return;
    }
    empty.hidden = true; body.hidden = false;
    el('cd-label').textContent = '「' + cd.name + '」还剩';
    if (el('cd-name').value === '') el('cd-name').value = cd.name;
    if (el('cd-date').value === '') {
      var d = new Date(cd.ts);
      el('cd-date').value = d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) + 'T' + pad2(d.getHours()) + ':' + pad2(d.getMinutes());
    }
    function tick() {
      var diff = cd.ts - Date.now();
      if (diff <= 0) {
        el('cd-clock').innerHTML = '<em>0</em> 天 00:00:00';
        return;
      }
      var s = Math.floor(diff / 1000);
      var d = Math.floor(s / 86400);
      var h = Math.floor(s % 86400 / 3600);
      var m = Math.floor(s % 3600 / 60);
      var sec = s % 60;
      el('cd-clock').innerHTML = '<em>' + d + '</em> 天 ' + pad2(h) + ':' + pad2(m) + ':' + pad2(sec);
    }
    tick();
    clearInterval(cdTimer);
    cdTimer = setInterval(tick, 1000);
  }
  el('cd-save').addEventListener('click', function () {
    var name = el('cd-name').value.trim();
    var dt = el('cd-date').value;
    if (!name || !dt) { alert('名称和日期都要填。'); return; }
    store('atouop:cd', { name: name, ts: new Date(dt).getTime() });
    cdRender(); renderStats();
  });
  el('cd-del').addEventListener('click', function () {
    if (!confirm('删除倒计时目标？')) return;
    localStorage.removeItem('atouop:cd');
    el('cd-name').value = ''; el('cd-date').value = '';
    cdRender(); renderStats();
  });

  // ===== 绩点 =====
  var gpaRows = load('atouop:gpa', []);
  if (!Array.isArray(gpaRows)) gpaRows = [];
  function gpaRender() {
    var empty = el('gpa-empty'), body = el('gpa-body');
    var valid = gpaRows.filter(function (r) { return r && (r.name || r.credit || r.score); });
    if (!valid.length) { empty.hidden = false; body.hidden = true; return; }
    empty.hidden = true; body.hidden = false;
    var tb = el('gpa-tbody');
    tb.innerHTML = '';
    gpaRows.forEach(function (r, i) {
      if (!r || (!r.name && !r.credit && !r.score)) return;
      var tr = document.createElement('tr');
      tr.innerHTML = '<td>' + esc(r.name) + '</td><td class="num">' + esc(r.credit) + '</td><td class="num">' + esc(r.score) + '</td>';
      var td = document.createElement('td');
      var btn = document.createElement('button');
      btn.className = 'btn danger sm'; btn.type = 'button'; btn.textContent = '删除';
      btn.addEventListener('click', function () {
        gpaRows.splice(i, 1);
        store('atouop:gpa', gpaRows);
        gpaRender(); renderStats();
      });
      td.appendChild(btn);
      tr.appendChild(td);
      tb.appendChild(tr);
    });
  }
  el('gpa-add').addEventListener('click', function () {
    var name = el('gpa-in-name').value.trim();
    var credit = el('gpa-in-credit').value.trim();
    var score = el('gpa-in-score').value.trim();
    if (!name) { alert('请填写课程名称。'); return; }
    if (!(parseFloat(credit) >= 0) || !(parseFloat(score) >= 0)) { alert('请填写有效的学分和分数。'); return; }
    gpaRows.push({ name: name, credit: credit, score: score });
    el('gpa-in-name').value = ''; el('gpa-in-credit').value = ''; el('gpa-in-score').value = '';
    store('atouop:gpa', gpaRows);
    gpaRender(); renderStats();
  });
  el('gpa-clear').addEventListener('click', function () {
    if (!gpaRows.length) return;
    if (!confirm('清空全部绩点课程？')) return;
    gpaRows = [];
    store('atouop:gpa', gpaRows);
    gpaRender(); renderStats();
  });

  // ===== 像素画 =====
  function pxRender() {
    var grid = load('atouop:pixels', []);
    var cv = el('px-canvas');
    var ctx = cv.getContext('2d');
    ctx.clearRect(0, 0, 256, 256);
    var filled = 0;
    if (Array.isArray(grid) && grid.length === 1024) {
      var cell = 256 / 32;
      for (var i = 0; i < 1024; i++) {
        if (grid[i]) {
          ctx.fillStyle = grid[i];
          ctx.fillRect((i % 32) * cell, Math.floor(i / 32) * cell, cell, cell);
          filled++;
        }
      }
    }
    el('px-meta').textContent = filled ? '32×32 画布 · 已涂 ' + filled + ' 格 · 与主页像素涂鸦同步' : '还没有像素画作品。在主页画一笔就会出现在这里。';
  }
  el('px-clear').addEventListener('click', function () {
    if (!confirm('清空像素画布？')) return;
    store('atouop:pixels', new Array(1024).fill(''));
    pxRender(); renderStats();
  });

  // ===== 随机选项 =====
  function randRender() {
    var v = load('atouop:choices', '');
    if (el('rand-options').value === '') el('rand-options').value = v;
  }
  el('rand-save').addEventListener('click', function () {
    store('atouop:choices', el('rand-options').value);
    var old = el('rand-save').textContent;
    el('rand-save').textContent = '已保存 ✓';
    setTimeout(function () { el('rand-save').textContent = old; }, 1200);
  });

  // ===== 世界时钟默认时区 =====
  var clockSel = el('clock-tz');
  ZONES.forEach(function (z) {
    var o = document.createElement('option');
    o.value = z[0]; o.textContent = z[1];
    clockSel.appendChild(o);
  });
  function clockSettingsRender() {
    var tz = load('atouop:clocktz', 480);
    clockSel.value = String(tz);
    var badge = el('clock-badge');
    if (tz === 480) { badge.textContent = '默认北京'; badge.classList.remove('on'); }
    else { badge.textContent = tzLabel(tz); badge.classList.add('on'); }
  }
  el('clock-save').addEventListener('click', function () {
    var tz = parseInt(clockSel.value, 10) || 0;
    store('atouop:clocktz', tz);
    clockSettingsRender(); renderStats();
    var old = el('clock-save').textContent;
    el('clock-save').textContent = '已保存 ✓';
    setTimeout(function () { el('clock-save').textContent = old; }, 1200);
  });
  el('clock-reset').addEventListener('click', function () {
    store('atouop:clocktz', 480);
    clockSettingsRender(); renderStats();
  });

  // ===== 每日一句 =====
  var qPick = el('q-pick');
  QUOTES.forEach(function (q, i) {
    var o = document.createElement('option');
    o.value = String(i);
    o.textContent = (i + 1) + '. ' + q[0].slice(0, 18) + '（' + q[1] + '）';
    qPick.appendChild(o);
  });
  function qRender() {
    var now0 = new Date();
    var doy = Math.floor((now0 - new Date(now0.getFullYear(), 0, 0)) / 86400000);
    var todayIdx = ((doy % QUOTES.length) + QUOTES.length) % QUOTES.length;
    el('q-today').innerHTML = '<div class="qt">「' + esc(QUOTES[todayIdx][0]) + '」</div><div class="qa">—— ' + esc(QUOTES[todayIdx][1]) + '</div>';
    var pin = load('atouop:pinquote', null);
    var badge = el('q-badge');
    if (pin == null) {
      badge.textContent = '未置顶'; badge.classList.remove('on');
      qPick.value = String(todayIdx);
    } else {
      pin = ((pin % QUOTES.length) + QUOTES.length) % QUOTES.length;
      badge.textContent = '已置顶第 ' + (pin + 1) + ' 句'; badge.classList.add('on');
      qPick.value = String(pin);
    }
  }
  el('q-pin').addEventListener('click', function () {
    store('atouop:pinquote', parseInt(qPick.value, 10));
    qRender(); renderStats();
    var old = el('q-pin').textContent;
    el('q-pin').textContent = '已置顶 ✓';
    setTimeout(function () { el('q-pin').textContent = old; }, 1200);
  });
  el('q-unpin').addEventListener('click', function () {
    localStorage.removeItem('atouop:pinquote');
    qRender(); renderStats();
  });

  // ===== 网盘解析记录 =====
  var panHist = load('atouop:panhist', []);
  if (!Array.isArray(panHist)) panHist = [];
  function panHistRender() {
    var box = el('pan-list');
    if (!panHist.length) { box.innerHTML = '<li class="t">还没有解析记录。在主页网盘助手里解析或打开链接后会记录在这里。</li>'; return; }
    box.innerHTML = '';
    panHist.forEach(function (h, i) {
      var li = document.createElement('li');
      var plat = document.createElement('span');
      plat.className = 'pan-plat'; plat.textContent = h.platform || '网盘';
      var link = document.createElement('span');
      link.className = 'pan-link t'; link.textContent = h.link || '';
      var tm = document.createElement('time');
      tm.textContent = h.ts ? fmtTime(h.ts) : '';
      var btn = document.createElement('button');
      btn.className = 'btn danger sm'; btn.type = 'button'; btn.textContent = '删除';
      btn.addEventListener('click', function () {
        panHist.splice(i, 1);
        store('atouop:panhist', panHist);
        panHistRender(); renderStats();
      });
      li.appendChild(plat); li.appendChild(link); li.appendChild(tm); li.appendChild(btn);
      box.appendChild(li);
    });
  }
  el('pan-clear').addEventListener('click', function () {
    if (!panHist.length) return;
    if (!confirm('清空全部网盘解析记录？')) return;
    panHist = [];
    store('atouop:panhist', panHist);
    panHistRender(); renderStats();
  });

  // ===== 访客统计 =====
  function visLocation(r) {
    var loc = [r.cc, r.region, r.city].filter(Boolean).join(' · ');
    return loc || '未知';
  }
  function visDevice(ua, path) {
    ua = ua || '';
    var d;
    if (/Mobile|Android|iPhone|iPod/i.test(ua)) d = '移动端';
    else if (/iPad|Tablet/i.test(ua)) d = '平板';
    else if (/Edg\//.test(ua)) d = 'Edge';
    else if (/Chrome\//.test(ua)) d = 'Chrome';
    else if (/Firefox\//.test(ua)) d = 'Firefox';
    else if (/Safari\//.test(ua)) d = 'Safari';
    else d = '其他';
    if (path && path !== '/' && path !== '/index.html') d += ' · ' + path;
    return d;
  }
  async function visLoad() {
    var pw = window.__ctrlPw || '';
    var tip = el('vis-tip'), body = el('vis-body');
    if (location.protocol === 'file:' || !pw) {
      el('st-hits').textContent = '—';
      el('st-uniq').textContent = '—';
      body.hidden = true; tip.hidden = false;
      tip.textContent = location.protocol === 'file:'
        ? '本地（file://）无法获取访客 IP；部署到 Cloudflare Pages 后自动显示。'
        : '请重新输入密码后查看访客统计。';
      return;
    }
    try {
      var res = await fetch('/api/stats?pw=' + encodeURIComponent(pw), { headers: { 'X-Password': pw } });
      if (!res.ok) throw new Error('unauthorized');
      var d = await res.json();
      el('st-hits').textContent = d.hits;
      el('st-uniq').textContent = d.unique;
      var tb = el('vis-tbody');
      tb.innerHTML = '';
      (d.recent || []).forEach(function (r) {
        var tr = document.createElement('tr');
        tr.innerHTML =
          '<td class="num">' + esc(r.ip || '—') + '</td>' +
          '<td>' + esc(visLocation(r)) + '</td>' +
          '<td class="num">' + (r.ts ? fmtTime(r.ts) : '—') + '</td>' +
          '<td>' + esc(visDevice(r.ua, r.path)) + '</td>';
        tb.appendChild(tr);
      });
      if ((d.recent || []).length) { tip.hidden = true; body.hidden = false; }
      else { body.hidden = true; tip.hidden = false; tip.textContent = '还没有访客记录。'; }
    } catch (e) {
      el('st-hits').textContent = '—';
      el('st-uniq').textContent = '—';
      body.hidden = true; tip.hidden = false;
      tip.textContent = '读取失败（密码不正确或尚未部署）。';
    }
  }
  el('vis-refresh').addEventListener('click', function () {
    var old = el('vis-refresh').textContent;
    el('vis-refresh').textContent = '…';
    visLoad().then(function () { el('vis-refresh').textContent = old; });
  });

  // ===== 启动 =====
  applyTheme();
  renderStats();
  damaRender();
  todoRender();
  cdRender();
  gpaRender();
  pxRender();
  randRender();
  clockSettingsRender();
  qRender();
  panHistRender();
  visLoad();
  setInterval(renderStats, 2000); // 倒计时/主页其他标签页改动可自动刷新统计
</script>
</body>
</html>
